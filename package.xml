<?xml version="1.0"?>
<package format="3">
  <name>v2i_rsu_monitor</name>
  <version>0.1.0</version>
  <description>RSU monitor converted to ROS2 node</description>
  <maintainer email="you@example.com">You</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <exec_depend>v2i_map_msgs</exec_depend>
  <exec_depend>v2i_sdsm_msgs</exec_depend>
  <exec_depend>v2i_spat_msgs</exec_depend>
  <exec_depend>pycmssdk</exec_depend>
  <exec_depend>PyQt5</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
